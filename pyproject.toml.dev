[build-system]
requires = ["flit_core==3.12.0"]
build-backend = "flit_core.buildapi"

[project]
name = "norman-api"
version = "0.1.0"
description = "Norman SDK"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "norman-exceptions",
    "norman-objects",
    "norman-utils",

    "aiofiles==24.1.0",
    "grpcio>=1.78.0",
    "httpx==0.28.1",
    "protobuf>=6.31.1",
    "xxhash==3.5.0"
]

[project.optional-dependencies]
dev = [
    "pytest==8.4.2",
    "pytest-asyncio==1.2.0"
]

[tool.flit.module]
name = "norman_api"

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "session"
asyncio_default_test_loop_scope = "session"
testpaths = ["tests"]
markers = [
    "authenticate: anything to do with the authentication service",
    "file_pull: anything to do with the file_pull service",
    "file_push: anything to do with the file_push service",
    "persist: anything to do with the persist service",
    "retrieve: anything to do with the retrieve service",

    "accounts: anything to do with account entities",
    "models: anything to do with model entities",
    "invocations: anything to do with invocation entities"
]

[tool.uv.sources]
norman-exceptions = { path = "../norman_exceptions", editable = true }
norman-objects = { path = "../norman_objects", editable = true }
norman-utils = { path = "../norman_utils", editable = true }
